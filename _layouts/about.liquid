---
layout: default
---
<div class="post quant-home">
  <header class="quant-hero">
    <div class="quant-hero-copy">
      <h1 class="post-title">
        {% if page.display_name %}
          {{ page.display_name | escape }}
        {% elsif site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="quant-hero-role">{{ page.subtitle }}</p>
      {% if page.research_focus %}
        <p class="quant-hero-focus">{{ page.research_focus | escape }}</p>
      {% endif %}
      {% if page.quantitative_projects %}
        <div class="quant-hero-actions">
          <a class="quant-hero-link" href="#quantitative-research-and-projects">Explore Quantitative Projects <span aria-hidden="true">↓</span></a>
          <a class="quant-hero-secondary" href="{{ '/cv/' | relative_url }}">View CV</a>
        </div>
      {% endif %}
    </div>
    {% if page.profile or page.social %}
      <aside class="quant-profile" aria-label="Profile and contact">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'quant-portrait' %}
          {% endif %}
          {% assign profile_image_alt = page.profile.alt | default: site.title %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes="(min-width: 640px) 216px, 160px" alt=profile_image_alt
            cache_bust=true
          %}
        {% endif %}
        {% if page.social %}
          <div class="quant-contact social">
            <div class="contact-icons">{% include social.liquid %}</div>
            {% assign email_addresses = site.email | append: ',' | append: site.secondary_email | split: ',' %}
            <ul class="quant-email-list" role="list" aria-label="Email addresses">
              {% for email_address in email_addresses %}
                {% if email_address != blank %}
                  {% assign email_parts = email_address | split: '@' %}
                  <li>
                    <a href="mailto:{{ email_address | encode_email }}">
                      {{- '' -}}
                      <span class="email-part">{{ email_parts[0] | replace: '.', ' DOT ' | escape }}</span>
                      <span class="email-part">AT {{ email_parts[1] | replace: '.', ' DOT ' | escape }}</span>
                      {{- '' -}}
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        {% if page.profile.more_info %}
          <div class="quant-profile-location">{{ page.profile.more_info }}</div>
        {% endif %}
      </aside>
    {% endif %}
  </header>

  <article class="quant-home-content">
    {{ content }}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}
  </article>
</div>
